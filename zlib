      # Build zlib with static linking
      - name: Build zlib static library
        run: |
          cd ${{ github.workspace }}
          # Download and extract zlib
          wget 'https://zlib.net/current/zlib.tar.gz'
          tar xzf zlib.tar.gz
          cd zlib-*
          
          # Configure and build with musl-gcc for static compilation
          CC=musl-gcc ./configure --prefix=${{ github.workspace }}/zlib_static --static
          make
          make install
          cd ..

      # Cache zlib static library for use in other jobs/runs
      - name: Cache zlib static library
        uses: actions/cache@v6
        with:
          path: ${{ github.workspace }}/zlib_static
          key: zlib-static-${{ runner.os }}-${{ hashFiles('**/zlib_static/lib/**') }}
          restore-keys: |
            zlib-static-${{ runner.os }}-

      # Upload zlib as artifact for other jobs to download
      - name: Upload zlib static library artifact
        uses: actions/upload-artifact@v6
        with:
          name: zlib-static-lib
          path: ${{ github.workspace }}/zlib_static
          retention-days: 30

      # Export zlib environment variables
      - name: Export zlib environment variables
        run: |
          echo "ZLIB_PREFIX=${{ github.workspace }}/zlib_static" >> $GITHUB_ENV
          echo "ZLIB_LDFLAGS=-L${{ github.workspace }}/zlib_static/lib -lz" >> $GITHUB_ENV
          echo "ZLIB_CFLAGS=-I${{ github.workspace }}/zlib_static/include" >> $GITHUB_ENV
          echo "PKG_CONFIG_PATH=${{ github.workspace }}/zlib_static/lib/pkgconfig:$PKG_CONFIG_PATH" >> $GITHUB_ENV
